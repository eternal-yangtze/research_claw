# ResearchOps 配置模板。复制为 .env 后填写；空值表示尚未配置。
# CLI 会自动加载项目根目录的 .env；已存在的进程环境变量优先。

# 必填：选择一家支持 Chat Completions 和 tool/function calling 的模型服务。
# 从同一服务商的 API 控制台取得根地址、API Key 和准确模型 ID。
# BASE_URL 不含末尾 /chat/completions；有些服务商要求根地址包含 /v1。
# API Key 是 API 平台签发的密钥，不是 Microsoft/GitHub 密码或网页登录令牌。
RESEARCHOPS_MODEL_BASE_URL=
RESEARCHOPS_MODEL_API_KEY=
RESEARCHOPS_MODEL_NAME=
# 可选：论文全文分析和计划生成可能比普通对话慢；默认 180 秒。
RESEARCHOPS_MODEL_TIMEOUT_SECONDS=180

# PDF 解析器：auto 优先 Docling、运行失败后回退 PyMuPDF；docling 表示失败即报错；
# pymupdf 表示直接使用快速文本提取。需要 OCR/公式增强时使用 auto 或 docling。
RESEARCHOPS_PDF_PARSER=auto

# 本地神经检索：首次运行会从 Hugging Face 下载模型，此后在本机推理，不需要 API Key。
RESEARCHOPS_RETRIEVAL_BACKEND=neural
RESEARCHOPS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RESEARCHOPS_EMBEDDING_REVISION=main
RESEARCHOPS_EMBEDDING_DEVICE=cpu
RESEARCHOPS_EMBEDDING_BATCH_SIZE=32
RESEARCHOPS_EMBEDDING_LOCAL_ONLY=false
RESEARCHOPS_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RESEARCHOPS_RERANKER_DEVICE=cpu
RESEARCHOPS_RERANKER_BATCH_SIZE=16
RESEARCHOPS_RERANKER_LOCAL_ONLY=false

# 向量后端：local 使用 SQLite 缓存 + 本地精确向量；qdrant 使用服务端 ANN。
# Qdrant 仅保存向量索引和范围 payload，原文、元数据与词法检索仍由 SQLite 管理。
RESEARCHOPS_VECTOR_BACKEND=local
RESEARCHOPS_QDRANT_URL=http://127.0.0.1:6333
# 留空时按项目自动生成 alias；多个项目手动配置时使用不同名称。
RESEARCHOPS_QDRANT_COLLECTION=
RESEARCHOPS_PROJECT_ID=
RESEARCHOPS_CORPUS_VERSION=v1

# 论文分析模式：legacy 保留原单次分析路径；micro 启用受预算的检索、回读和修订循环。
RESEARCHOPS_PAPER_ANALYZER_MODE=legacy
# micro 原文回读：inprocess 或 mcp（官方 SDK stdio；由 agent extra 提供）。
# 切换传输方式使用新运行/新 checkpoint；默认 inprocess 保留原路径。
RESEARCHOPS_PAPER_READ_TRANSPORT=inprocess
# 仅直接/CLI 分析未收到外层 BudgetedModel 时使用此根额度；已有外层账本时沿用外层额度。
RESEARCHOPS_PAPER_ROOT_TOKEN_CAP=2000000

# 方案编排：默认 langgraph；native 使用原生方案循环。
# 更改模式请使用新输出工作区；图 checkpoint 不与旧循环混用。
RESEARCHOPS_STUDY_ORCHESTRATOR=langgraph

# 论文获取 DAG 的最大并行节点数，范围 1-16。
RESEARCHOPS_ACQUIRE_WORKERS=4

# 当前自主文献获取使用 arXiv、OpenAlex、OpenReview、DBLP、Crossref、ACL Anthology
# 和 CVF Open Access，不依赖 Semantic Scholar。ACL/CVF 均无需 Key 或邮箱。
# 可选：限制 CVF 官方会议目录；格式为会议名和年份，以英文逗号分隔。
RESEARCHOPS_CVF_VENUES=CVPR2025,ICCV2025,WACV2025

# 可选：OpenAlex 匿名检索可直接运行；只有需要更高配额时才从
# https://openalex.org/settings/api 获取 API Key。
# 如果网页要求登录，使用你注册 OpenAlex 的账户；不要求绑定特定 Microsoft/GitHub 邮箱。
PAPER_SEARCH_MCP_OPENALEX_API_KEY=

# 学术 API 联系邮箱：填写本人可收信的真实邮箱，可以是学校、Outlook、Gmail、QQ 等。
# 这些不是登录凭据，也不要求与 Microsoft/GitHub 绑定；下方可全部填写同一个邮箱。
# OpenAlex：请求联系信息，不能代替 API Key。
PAPER_SEARCH_MCP_OPENALEX_EMAIL=
# Crossref：API 请求联系信息；基础检索不需要 Key，不要求先注册 Crossref 账户。
CROSSREF_MAILTO=
# Unpaywall：当前 research 自主流程不调用。后续如启用 DOI 开放全文解析时使用。
# 不要求与 Microsoft/GitHub 绑定，也不填写邮箱密码。
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=

# 禁用预留：当前代码不会调用 Semantic Scholar；字段留作未来显式启用时兼容。
# 申请入口：https://www.semanticscholar.org/product/api
# 它是平台签发的 API Key，不是 Semantic Scholar 登录密码。
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=

# arXiv 公开 API、本地 Docling/OCR、本地 embedding/reranker 无需商业 API Key。
