# Copy to .env.harness and supply deployment secrets; never commit the result.
RESEARCHCLAW_JWT_SECRET=replace-with-at-least-32-random-bytes
RESEARCHCLAW_WEB_PASSWORD=replace-with-registration-secret
RESEARCHCLAW_POSTGRES_DSN=postgresql://researchclaw:replace-password@host.docker.internal:5432/researchclaw
RESEARCHCLAW_QDRANT_URL=http://host.docker.internal:6333
RESEARCHCLAW_SECURE_COOKIE=0
RESEARCHCLAW_QUEUE_CAPACITY=256
RESEARCHCLAW_OWNER_CAPACITY=16
RESEARCHCLAW_CONTEXT_WINDOW=16384
RESEARCHCLAW_WEB_MODEL_TIMEOUT_SECONDS=120
RESEARCHCLAW_WEB_AGENT_TIMEOUT_SECONDS=600
# Set the same model gateway variables as your existing .env in this file.
