FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TIKTOKEN_CACHE_DIR=/opt/tokenizers
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/
COPY backend/src/ backend/src/
RUN pip install --no-cache-dir '.[web,agent,durable,pdf]'
COPY config/ config/
COPY skills/ skills/
COPY self-revise/backend-revise/internal_experiments/assets/tokenizers/ /opt/tokenizers/
EXPOSE 8000
CMD ["uvicorn","researchclaw_api.main:create_app","--factory","--host","0.0.0.0","--port","8000","--workers","2"]
