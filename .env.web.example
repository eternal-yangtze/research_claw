# Copy to .env.web; keep all real values private.
RESEARCHOPS_WEB_PASSWORD=replace-with-a-strong-local-password
RESEARCHOPS_JWT_SECRET=replace-with-at-least-32-random-bytes
RESEARCHOPS_SECURE_COOKIE=0
RESEARCHOPS_WEB_WORKSPACE=web_workspace
RESEARCHOPS_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
