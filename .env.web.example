# Copy to .env.web; keep all real values private.
RESEARCHCLAW_WEB_PASSWORD=replace-with-a-strong-local-password
RESEARCHCLAW_JWT_SECRET=replace-with-at-least-32-random-bytes
RESEARCHCLAW_SECURE_COOKIE=0
RESEARCHCLAW_WEB_MODEL_STREAM=1
RESEARCHCLAW_WEB_WORKSPACE=web_workspace
RESEARCHCLAW_KNOWLEDGE_BACKEND=qdrant
RESEARCHCLAW_VECTOR_BACKEND=qdrant
RESEARCHCLAW_RETRIEVAL_BACKEND=neural
RESEARCHCLAW_QDRANT_URL=http://127.0.0.1:6333
# Empty uses the accepted infra/compose.yaml and infra/.env on this machine.
# Retired DATABASE_URL / POSTGRES_PORT / POSTGRES_PASSWORD settings are ignored.
RESEARCHCLAW_POSTGRES_DSN=
RESEARCHCLAW_FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
# Online context budget. cl100k_base is a configured proxy for providers whose
# exact tokenizer is not exposed; keep the margin, do not mark verified blindly.
RESEARCHCLAW_CONTEXT_WINDOW=16384
RESEARCHCLAW_CONTEXT_ENCODING=cl100k_base
RESEARCHCLAW_CONTEXT_ENCODING_VERIFIED=0
# New UI uses invited local accounts. WEB_PASSWORD is the registration/history-claim
# invitation code; each registered user logs in with their own PBKDF2-protected password.
RESEARCHCLAW_ALLOW_LEGACY_LOGIN=0
# Uploads remain staged until an authenticated, one-use ingestion confirmation.
RESEARCHCLAW_ALLOW_DIRECT_INGEST=0
